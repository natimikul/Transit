# Шаблон конфигурации секретов.
# Скопируйте этот файл в .streamlit/secrets.toml и заполните своими значениями.
# Файл .streamlit/secrets.toml НЕ должен попадать в git (добавьте его в .gitignore).

# --- Авторизация: пароли хранятся ТОЛЬКО в виде bcrypt-хэшей ---
# Сгенерировать хэш для своего пароля:
#   python -c "import bcrypt; print(bcrypt.hashpw('ВАШ_ПАРОЛЬ'.encode(), bcrypt.gensalt(rounds=12)).decode())"
[auth]
user_password_hash = "$2b$12$ЗАМЕНИТЕ_НА_СВОЙ_ХЭШ_ПОЛЬЗОВАТЕЛЯ"
admin_password_hash = "$2b$12$ЗАМЕНИТЕ_НА_СВОЙ_ХЭШ_АДМИНА"
max_attempts = 5
lockout_seconds = 300

# --- Параметры почты для отправки уведомлений ---
[email]
sender_email = "your_address@gmail.com"
sender_password = "app_password_from_google"
